<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>build.spin</groupId>
        <artifactId>project</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>spin</artifactId>
    <packaging>jar</packaging>

    <name>Spin Command Line Application</name>

    <dependencies>
        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-api</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-common</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-engine</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>

        <!-- ServiceLoader-discovered plugin modules -->
        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-checkstyle-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-clean-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-configuration-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-git-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-gpg-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-java-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-junit-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-maven-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-module-system-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-reporting-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-commandline</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-configuration</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-flow</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-foundation</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-option</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-table</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <configuration>
                    <ignoredUnusedDeclaredDependencies>
                        <!-- ServiceLoader-discovered plugin modules; no direct class imports -->
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-checkstyle-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-clean-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-configuration-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-git-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-gpg-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-java-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-junit-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-maven-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-module-system-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-reporting-module</ignoredUnusedDeclaredDependency>
                    </ignoredUnusedDeclaredDependencies>
                </configuration>
            </plugin>

            <plugin>
                <groupId>build.spin</groupId>
                <artifactId>spin-maven-plugin</artifactId>
                <version>${revision}</version>
                <executions>
                    <!-- Maven builds spin₁; spin₁ builds spin₂ (jlink image) -->
                    <execution>
                        <id>spin1-build-spin2</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <mainClass>build.spin.application.Spin</mainClass>
                            <rootModule>build.spin.application</rootModule>
                            <scope>runtime</scope>
                            <additionalJvmArgs>
                                <additionalJvmArg>--enable-preview</additionalJvmArg>
                            </additionalJvmArgs>
                            <arguments>
                                <argument>clean</argument>
                                <argument>jlink</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <!-- spin₂ builds spin₃, then verify spin₂ == spin₃ -->
                    <execution>
                        <id>spin2-build-spin3</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>-c</argument>
                                <argument>
                                    case "$(uname -s)" in Darwin) HOST_OS=mac ;; Linux) HOST_OS=linux ;; *) HOST_OS=other ;; esac
                                    case "$(uname -m)" in arm64|aarch64) HOST_ARCH=aarch64 ;; x86_64|amd64) HOST_ARCH=x86_64 ;; *) HOST_ARCH=other ;; esac
                                    HOST_DIR=".build/spin-${HOST_OS}-${HOST_ARCH}"
                                    rm -rf /tmp/spin2 /tmp/spin2-modules.txt /tmp/spin3-modules.txt /tmp/spin2-extmodules.txt /tmp/spin3-extmodules.txt /tmp/spin2-classpath.txt /tmp/spin3-classpath.txt &amp;&amp;
                                    # move spin₂ aside: both spin₂ and spin₃ write to the host's own target directory, so spin₂ must vacate before spin₃ can be built
                                    cp -r "$HOST_DIR" /tmp/spin2 &amp;&amp;
                                    /tmp/spin2/bin/spin.sh clean jlink &amp;&amp;
                                    # structural equivalence check (launcher + linked/external module sets); jar contents are not diffed as jars embed build timestamps
                                    diff /tmp/spin2/bin/spin.sh "$HOST_DIR"/bin/spin.sh &amp;&amp;
                                    /tmp/spin2/bin/java --list-modules | sort &gt; /tmp/spin2-modules.txt &amp;&amp;
                                    "$HOST_DIR"/bin/java --list-modules | sort &gt; /tmp/spin3-modules.txt &amp;&amp;
                                    diff /tmp/spin2-modules.txt /tmp/spin3-modules.txt &amp;&amp;
                                    # modules/ and classpath/ are only written when non-empty (see AbstractJavaLinker) — tolerate either being absent
                                    { [ -d /tmp/spin2/modules ] &amp;&amp; ls /tmp/spin2/modules | sort || true; } &gt; /tmp/spin2-extmodules.txt &amp;&amp;
                                    { [ -d "$HOST_DIR"/modules ] &amp;&amp; ls "$HOST_DIR"/modules | sort || true; } &gt; /tmp/spin3-extmodules.txt &amp;&amp;
                                    diff /tmp/spin2-extmodules.txt /tmp/spin3-extmodules.txt &amp;&amp;
                                    { [ -d /tmp/spin2/classpath ] &amp;&amp; ls /tmp/spin2/classpath | sort || true; } &gt; /tmp/spin2-classpath.txt &amp;&amp;
                                    { [ -d "$HOST_DIR"/classpath ] &amp;&amp; ls "$HOST_DIR"/classpath | sort || true; } &gt; /tmp/spin3-classpath.txt &amp;&amp;
                                    diff /tmp/spin2-classpath.txt /tmp/spin3-classpath.txt &amp;&amp;
                                    rm -rf /tmp/spin2 /tmp/spin2-modules.txt /tmp/spin3-modules.txt /tmp/spin2-extmodules.txt /tmp/spin3-extmodules.txt /tmp/spin2-classpath.txt /tmp/spin3-classpath.txt
                                </argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/src.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
