<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>build.spin.module</groupId>
        <artifactId>spin-modules</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>spin-java-module-tests</artifactId>
    <packaging>jar</packaging>

    <name>Spin Java Module Tests</name>

    <properties>
        <central.publishing.skip>true</central.publishing.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-api</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-common</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-testing</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>

        <!-- ServiceLoader-discovered plugin modules -->
        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-checkstyle-module</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-clean-module</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-java-module</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-junit-module</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-maven-module</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-module-system-module</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-assertion</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-configuration</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-flow</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-foundation</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-io</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-option</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-telemetry</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-version</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.codemodel</groupId>
            <artifactId>codemodel-jdk</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.codemodel</groupId>
            <artifactId>codemodel-foundation</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.spawn</groupId>
            <artifactId>spawn-application</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.spawn</groupId>
            <artifactId>spawn-jdk</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.spawn</groupId>
            <artifactId>spawn-local-jdk</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>build.spawn</groupId>
            <artifactId>spawn-local-platform</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Generate a curated module-path / class-path argfile for surefire.
                 Runs ModuleGraphClassifier against the test classpath so that split-package
                 jars in the Maven Core closure (maven-settings vs maven-support on
                 org.apache.maven.settings.v4, maven-model vs maven-model-builder on
                 org.apache.maven.model.merge, maven-artifact vs maven-repository-metadata on
                 org.apache.maven.artifact.repository.metadata) resolve the same way spin
                 resolves them at runtime: tier (a) required-module preference keeps
                 maven.settings, maven.model, maven.artifact on the module path while demoting
                 their helper siblings. Seed comes from the direct dependency module names
                 (this module has no source module-info.java of its own). -->
            <plugin>
                <groupId>build.spin</groupId>
                <artifactId>spin-maven-plugin</artifactId>
                <version>${revision}</version>
                <executions>
                    <execution>
                        <id>classify-test-compile</id>
                        <!-- Bind explicitly because Maven doesn't reliably pick up the
                             defaultPhase from the hand-written plugin.xml descriptor. -->
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>classify-test-compile-path</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- Disable maven-compiler-plugin's own module-path classification
                                 for test-compile. It would otherwise dump the full test dep
                                 closure onto javac's module-path and re-trip the Maven Core
                                 split packages (maven-settings vs maven-support on
                                 org.apache.maven.settings.v4, and friends). Instead we inject
                                 the curated path computed by spin-maven-plugin via
                                 project properties exposed at generate-test-sources phase. -->
                            <useModulePath>false</useModulePath>
                            <compilerArgs>
                                <arg>--module-path</arg>
                                <arg>${spin.classify.test.modulepath}</arg>
                                <arg>--class-path</arg>
                                <arg>${spin.classify.test.classpath}</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- Disable surefire's own module-path classification. Once the test
                         module has a module-info.java, surefire detects modular mode and
                         computes its own module-path from the full test dep closure — which
                         re-introduces the Maven Core split packages (maven-settings vs
                         maven-support on org.apache.maven.settings.v4, and friends) that
                         our classifier just carefully resolved. useModulePath=false keeps
                         surefire in classpath mode; our argLine then injects the curated
                         module-path from spin-maven-plugin. -->
                    <useModulePath>false</useModulePath>
                    <!-- argLine injects the curated module-path (same argfile the
                         test-compile execution consumes via project properties) into the
                         test JVM so spin's extension jars are loaded as named modules and
                         their `provides build.spin.Extension.MetaClass` declarations are
                         visible to ServiceLoader.

                         The `-add-exports` prefix works around a JUnit Platform wiring
                         quirk: junit-platform-commons is on our curated -module-path (as
                         a named module, because it's a declared test dep), but
                         junit-platform-launcher lives on surefire's -cp in the unnamed
                         module (surefire injects it for the booter). When LauncherFactory
                         in the unnamed module calls into the commons jar's internal
                         `org.junit.platform.commons.util.Preconditions`, named-module
                         strong encapsulation denies access. Opening `util` to the unnamed
                         module is the standard JPMS escape hatch for this scenario. -->
                    <argLine>${surefire.jvm.args} --add-exports=org.junit.platform.commons/org.junit.platform.commons.util=ALL-UNNAMED --add-exports=org.junit.platform.commons/org.junit.platform.commons.logging=ALL-UNNAMED @${project.build.directory}/spin-classify-test.args</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <configuration>
                    <ignoredUnusedDeclaredDependencies>
                        <!-- ServiceLoader-discovered plugin modules; no direct class imports -->
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-checkstyle-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-clean-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-java-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-junit-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-maven-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-module-system-module</ignoredUnusedDeclaredDependency>
                    </ignoredUnusedDeclaredDependencies>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
