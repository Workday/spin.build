<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">

    <parent/>

    <groupId>build.spin.module</groupId>
    <artifactId>spin-modules</artifactId>

    <packaging>pom</packaging>

    <name>Spin Modules</name>

    <dependencies>
        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-engine</artifactId>
            <version>${revision}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>analyze-dependencies</id>
                        <configuration>
                            <ignoredUnusedDeclaredDependencies>
                                <!-- spin-engine is declared in the parent pom for JPMS module-path
                                     resolution; bytecode analyzer marks it unused since modules use
                                     its packages transitively via module-info, not via direct imports.
                                     Note: any new module added under spin-modules/ will inherit this
                                     dependency automatically. -->
                                <ignoredUnusedDeclaredDependency>build.spin:spin-engine</ignoredUnusedDeclaredDependency>
                            </ignoredUnusedDeclaredDependencies>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <subprojects>
        <subproject>spin-clean-module</subproject>
        <subproject>spin-checkstyle-module</subproject>
        <subproject>spin-configuration-module</subproject>
        <subproject>spin-console-module</subproject>
        <subproject>spin-git-module</subproject>
        <subproject>spin-java-module</subproject>
        <subproject>spin-engine-tests</subproject>
        <subproject>spin-java-module-tests</subproject>
        <subproject>spin-junit-module</subproject>
        <subproject>spin-maven-module</subproject>
        <subproject>spin-module-system-module</subproject>
        <subproject>spin-language-server-module</subproject>
        <subproject>spin-reporting-module</subproject>
    </subprojects>
</project>
