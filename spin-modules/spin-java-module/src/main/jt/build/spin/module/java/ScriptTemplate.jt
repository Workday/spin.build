package build.spin.module.java;

template TextOut ScriptTemplate(String classpath, String rootModule, String mainClass, String name) {
#!/bin/sh

SCRIPTPATH=$(dirname `readlink -f "$0"`)

MP=`readlink -f "$SCRIPTPATH/../modules"`
LIB=`readlink -f "$SCRIPTPATH/../classpath"`

$SCRIPTPATH/java --enable-preview --module-path $MP#{classpath != null && !classpath.isEmpty() ? " -cp " + classpath : ""} -m #{rootModule}/#{mainClass} $@
@end
