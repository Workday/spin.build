            <dependency>
                <!-- In Maven Resolver 2.x the old maven-resolver-supplier artifact was split
                     into maven-resolver-supplier-mvn3 (Maven 3 model compat) and -mvn4 (Maven 4).
                     We use -mvn4 to match maven.version 4.x; the -mvn3 variant calls a
                     DefaultVersionRangeResolver constructor that no longer exists in the
                     Maven 4 maven-resolver-provider. -->
                <groupId>org.apache.maven.resolver</groupId>
                <artifactId>maven-resolver-supplier-mvn4</artifactId>
                <version>${maven.resolver.version}</version>
            </dependency>

