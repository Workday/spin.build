<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.1.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">

    <parent>
        <groupId>build.spin</groupId>
        <artifactId>project</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>spin</artifactId>
    <packaging>jar</packaging>

    <name>Spin Command Line Application</name>

    <dependencies>
        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-api</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-common</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-engine</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin</groupId>
            <artifactId>spin-testing</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
        </dependency>

        <!-- ServiceLoader-discovered plugin modules -->
        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-checkstyle-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-clean-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-configuration-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-console-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-git-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-java-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-junit-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-language-server-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-maven-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-module-system-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.spin.module</groupId>
            <artifactId>spin-reporting-module</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-commandline</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-configuration</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-flow</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-foundation</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-option</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-table</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <configuration>
                    <ignoredUnusedDeclaredDependencies>
                        <!-- ServiceLoader-discovered plugin modules; no direct class imports -->
                        <ignoredUnusedDeclaredDependency>build.spin:spin-testing</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-checkstyle-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-clean-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-configuration-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-console-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-git-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-java-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-junit-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-language-server-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-maven-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-module-system-module</ignoredUnusedDeclaredDependency>
                        <ignoredUnusedDeclaredDependency>build.spin.module:spin-reporting-module</ignoredUnusedDeclaredDependency>
                        <!-- runtime logging implementation -->
                        <ignoredUnusedDeclaredDependency>org.slf4j:slf4j-simple</ignoredUnusedDeclaredDependency>
                    </ignoredUnusedDeclaredDependencies>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <!-- Maven builds spin₁; spin₁ builds spin₂ (jlink image) -->
                    <execution>
                        <id>spin1-build-spin2</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <longClasspath>true</longClasspath>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <!-- Launcher bridges exec-maven-plugin's flat classpath into a proper
                                     modular launch: it classifies jars via ModuleFinder + Configuration.resolve,
                                     demotes split-package conflicts (e.g. Maven Resolver 1.x), and re-execs
                                     the JVM with the correct -module-path + -cp + -m build.spin.application/Spin. -->
                                <argument>--enable-preview</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>build.spin.application.Launcher</argument>
                                <argument>clean</argument>
                                <argument>jlink</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <!-- spin₂ builds spin₃, then verify spin₂ == spin₃ -->
                    <execution>
                        <id>spin2-build-spin3</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>-c</argument>
                                <argument>
                                    rm -rf /tmp/spin2 /tmp/spin2-modules.txt /tmp/spin3-modules.txt &amp;&amp;
                                    # move spin₂ aside: both spin₂ and spin₃ write to .build/spin, so spin₂ must vacate before spin₃ can be built
                                    cp -r .build/spin /tmp/spin2 &amp;&amp;
                                    /tmp/spin2/bin/spin.sh clean jlink &amp;&amp;
                                    # structural equivalence check (launcher + module set); jar contents are not diffed as jars embed build timestamps
                                    diff /tmp/spin2/bin/spin.sh .build/spin/bin/spin.sh &amp;&amp;
                                    ls /tmp/spin2/modules | sort &gt; /tmp/spin2-modules.txt &amp;&amp;
                                    ls .build/spin/modules | sort &gt; /tmp/spin3-modules.txt &amp;&amp;
                                    diff /tmp/spin2-modules.txt /tmp/spin3-modules.txt &amp;&amp;
                                    rm -rf /tmp/spin2 /tmp/spin2-modules.txt /tmp/spin3-modules.txt
                                </argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/src.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
